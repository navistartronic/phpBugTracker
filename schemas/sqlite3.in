# SQLlite3 database creation template
#
# SQLite3 database creation template based on MySQL database template.
# Modified for sqlite3 syntax.
#
# This is a template for install.php -- not for creating the database!
#
# $Id: mysqli.in,v 1.11 2008/10/06 03:41:20 brycen Exp $


CREATE TABLE TBL_ATTACHMENT (
  attachment_id integer not null default '0',
  bug_id        integer not null default '0',
  file_name     character(255) not null default '',
  description   character(255) not null default '',
  file_size     bigint not null default '0',
  mime_type     character(30) not null default '',
  created_by    integer not null default '0',
  created_date  bigint not null default '0',
  PRIMARY KEY (attachment_id)
);

CREATE TABLE TBL_AUTH_GROUP (
  group_id INTEGER NOT NULL DEFAULT '0',
  group_name VARCHAR(80) NOT NULL DEFAULT '',
  locked TINYINT NOT NULL DEFAULT '0',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  last_modified_by INTEGER NOT NULL DEFAULT '0',
  last_modified_date BIGINT NOT NULL DEFAULT '0',
  is_role TINYINT NOT NULL DEFAULT '0',
  PRIMARY KEY (group_id)
);

CREATE TABLE TBL_AUTH_PERM (
  perm_id INTEGER NOT NULL DEFAULT '0',
  perm_name VARCHAR(80) NOT NULL DEFAULT '',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  last_modified_by INTEGER NOT NULL DEFAULT '0',
  last_modified_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (perm_id)
);

CREATE TABLE TBL_AUTH_USER (
  user_id INTEGER NOT NULL DEFAULT '0',
  login CHARACTER(60) NOT NULL DEFAULT '',
  first_name CHARACTER(40) NOT NULL DEFAULT '',
  last_name CHARACTER(40) NOT NULL DEFAULT '',
  email CHARACTER(60) NOT NULL DEFAULT '',
  password CHARACTER(40) NOT NULL DEFAULT '',
  active TINYINT NOT NULL DEFAULT '1',
  bug_list_fields TEXT NULL ,
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  last_modified_by INTEGER NOT NULL DEFAULT '0',
  last_modified_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (user_id)
);

CREATE TABLE TBL_BOOKMARK (
  user_id INTEGER NOT NULL DEFAULT '0',
  bug_id INTEGER NOT NULL DEFAULT '0'
);

CREATE TABLE TBL_BUG (
  bug_id INTEGER NOT NULL DEFAULT '0',
  title VARCHAR(100) NOT NULL DEFAULT '',
  description TEXT NOT NULL ,
  url VARCHAR(255) NOT NULL DEFAULT '',
  severity_id TINYINT NOT NULL DEFAULT '0',
  priority TINYINT NOT NULL DEFAULT '0',
  status_id TINYINT NOT NULL DEFAULT '0',
  resolution_id TINYINT NOT NULL DEFAULT '0',
  database_id TINYINT NOT NULL DEFAULT '0',
  site_id TINYINT NOT NULL DEFAULT '0',
  assigned_to INTEGER NOT NULL DEFAULT '0',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  last_modified_by INTEGER NOT NULL DEFAULT '0',
  last_modified_date BIGINT NOT NULL DEFAULT '0',
  project_id INTEGER NOT NULL DEFAULT '0',
  version_id INTEGER NOT NULL DEFAULT '0',
  component_id INTEGER NOT NULL DEFAULT '0',
  os_id TINYINT NOT NULL DEFAULT '0',
  browser_string VARCHAR(255) NOT NULL DEFAULT '',
  close_date BIGINT NOT NULL DEFAULT '0',
  closed_in_version_id INTEGER NOT NULL DEFAULT '0',
  to_be_closed_in_version_id INTEGER NOT NULL DEFAULT '0',
  PRIMARY KEY (bug_id)
);

CREATE TABLE TBL_BUG_CC (
  bug_id INTEGER NOT NULL DEFAULT '0',
  user_id INTEGER NOT NULL DEFAULT '0',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (bug_id, user_id)
);

CREATE TABLE TBL_BUG_COMMENT (
  comment_id INTEGER NOT NULL DEFAULT '0',
  bug_id INTEGER NOT NULL DEFAULT '0',
  comment_text TEXT NOT NULL ,
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (comment_id)
);

CREATE TABLE TBL_BUG_DEPENDENCY (
  bug_id INTEGER NOT NULL DEFAULT '0',
  depends_on INTEGER NOT NULL DEFAULT '0',
  PRIMARY KEY (bug_id, depends_on)
);

CREATE TABLE TBL_BUG_GROUP (
  bug_id INTEGER NOT NULL DEFAULT '0',
  group_id INTEGER NOT NULL DEFAULT '0',
  PRIMARY KEY (bug_id, group_id)
);

CREATE TABLE TBL_BUG_HISTORY (
  bug_id INTEGER NOT NULL DEFAULT '0',
  changed_field VARCHAR(30) NOT NULL DEFAULT '',
  old_value VARCHAR(255) NOT NULL DEFAULT '',
  new_value VARCHAR(255) NOT NULL DEFAULT '',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0'
);

CREATE TABLE TBL_BUG_VOTE (
  user_id INTEGER NOT NULL DEFAULT '0',
  bug_id INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (user_id, bug_id)
);

CREATE TABLE TBL_COMPONENT (
  component_id INTEGER NOT NULL DEFAULT '0',
  project_id INTEGER NOT NULL DEFAULT '0',
  component_name VARCHAR(30) NOT NULL DEFAULT '',
  component_desc TEXT NOT NULL ,
  owner INTEGER NOT NULL DEFAULT '0',
  active TINYINT NOT NULL DEFAULT '1',
  sort_order TINYINT NOT NULL DEFAULT '0',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  last_modified_by INTEGER NOT NULL DEFAULT '0',
  last_modified_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (component_id)
);

CREATE TABLE TBL_CONFIGURATION (
  varname CHARACTER(40) NOT NULL DEFAULT '',
  varvalue CHARACTER(255) NOT NULL DEFAULT '',
  description CHARACTER(255) NOT NULL DEFAULT '',
  vartype CHARACTER(20) NOT NULL DEFAULT '',
  PRIMARY KEY (varname)
);

CREATE TABLE TBL_DATABASE (
  database_id TINYINT NOT NULL DEFAULT '0',
  database_name VARCHAR(40) NOT NULL DEFAULT '',
  sort_order TINYINT NOT NULL DEFAULT '0',
  PRIMARY KEY (database_id)
);

# table load insert into group_perm ... is done by schemas/common.in
CREATE TABLE TBL_GROUP_PERM (
  group_id INTEGER NOT NULL DEFAULT '0',
  perm_id INTEGER NOT NULL DEFAULT '0',
  PRIMARY KEY (group_id, perm_id)
);

CREATE TABLE TBL_OS (
  os_id INTEGER NOT NULL DEFAULT '0',
  os_name CHARACTER(30) NOT NULL DEFAULT '',
  sort_order TINYINT NOT NULL DEFAULT '0',
  regex CHARACTER(40) NOT NULL DEFAULT '',
  PRIMARY KEY (os_id)
);

CREATE TABLE TBL_PRIORITY (
  priority_id INTEGER NOT NULL DEFAULT '0',
  priority_name VARCHAR(30) NOT NULL DEFAULT '',
  priority_desc TEXT NOT NULL ,
  sort_order TINYINT NOT NULL DEFAULT '0',
  priority_color VARCHAR(10) NOT NULL DEFAULT '#FFFFFF',
  PRIMARY KEY (priority_id)
);

CREATE TABLE TBL_PROJECT (
  project_id INTEGER NOT NULL DEFAULT '0',
  project_name VARCHAR(30) NOT NULL DEFAULT '',
  project_desc TEXT NOT NULL ,
  active TINYINT NOT NULL DEFAULT '1',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  last_modified_by INTEGER NOT NULL DEFAULT '0',
  last_modified_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (project_id)
);

CREATE TABLE TBL_PROJECT_GROUP (
  project_id INTEGER NOT NULL DEFAULT '0',
  group_id INTEGER NOT NULL DEFAULT '0',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (project_id, group_id)
);

CREATE TABLE TBL_PROJECT_PERM (
  project_id INTEGER NOT NULL DEFAULT '0',
  user_id INTEGER NOT NULL DEFAULT '0'
);

CREATE TABLE TBL_RESOLUTION (
  resolution_id INTEGER NOT NULL DEFAULT '0',
  resolution_name VARCHAR(30) NOT NULL DEFAULT '',
  resolution_desc TEXT NOT NULL ,
  sort_order TINYINT NOT NULL DEFAULT '0',
  PRIMARY KEY (resolution_id)
);

CREATE TABLE TBL_SAVED_QUERY (
  saved_query_id INTEGER NOT NULL DEFAULT '0',
  user_id INTEGER NOT NULL DEFAULT '0',
  saved_query_name VARCHAR(40) NOT NULL DEFAULT '',
  saved_query_string TEXT NOT NULL ,
  PRIMARY KEY (saved_query_id, user_id)
);

CREATE TABLE TBL_SEVERITY (
  severity_id INTEGER NOT NULL DEFAULT '0',
  severity_name VARCHAR(30) NOT NULL DEFAULT '',
  severity_desc TEXT NOT NULL ,
  sort_order TINYINT NOT NULL DEFAULT '0',
  severity_color VARCHAR(10) NOT NULL DEFAULT '#FFFFFF',
  PRIMARY KEY (severity_id)
);

CREATE TABLE TBL_SITE (
  site_id TINYINT NOT NULL DEFAULT '0',
  site_name VARCHAR(50) NOT NULL DEFAULT '',
  sort_order TINYINT NOT NULL DEFAULT '0',
  PRIMARY KEY (site_id)
);

CREATE TABLE TBL_STATUS (
  status_id INTEGER NOT NULL DEFAULT '0',
  status_name VARCHAR(30) NOT NULL DEFAULT '',
  status_desc TEXT NOT NULL ,
  sort_order TINYINT NOT NULL DEFAULT '0',
  bug_open TINYINT NOT NULL DEFAULT '1',
  PRIMARY KEY (status_id)
);

CREATE TABLE TBL_USER_GROUP (
  user_id INTEGER NOT NULL DEFAULT '0',
  group_id INTEGER NOT NULL DEFAULT '0',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (user_id, group_id)
);

CREATE TABLE TBL_USER_PERM (
  user_id INTEGER NOT NULL DEFAULT '0',
  perm_id INTEGER NOT NULL DEFAULT '0',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (user_id, perm_id)
);

CREATE TABLE TBL_USER_PREF (
  user_id INTEGER NOT NULL DEFAULT '0',
  email_notices TINYINT NOT NULL DEFAULT '1',
  saved_queries TINYINT NOT NULL DEFAULT '1',
  def_results INTEGER NOT NULL DEFAULT '20',
  PRIMARY KEY (user_id)
);

CREATE TABLE TBL_VERSION (
  version_id INTEGER NOT NULL DEFAULT '0',
  project_id INTEGER NOT NULL DEFAULT '0',
  version_name CHARACTER(30) NOT NULL DEFAULT '',
  active TINYINT NOT NULL DEFAULT '1',
  sort_order TINYINT NOT NULL DEFAULT '0',
  created_by INTEGER NOT NULL DEFAULT '0',
  created_date BIGINT NOT NULL DEFAULT '0',
  last_modified_by INTEGER NOT NULL DEFAULT '0',
  last_modified_date BIGINT NOT NULL DEFAULT '0',
  PRIMARY KEY (version_id)
);

# ---- same data loads for all databases types -----

