# Part 3 of 3: create and set starting sequences ...

# sqlite3:
CREATE TABLE TBL_ATTACHMENT_seq  (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_BUG_seq         (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_BUG_COMMENT_seq (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_COMPONENT_seq   (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_PROJECT_seq     (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_STATUS_seq      (id INTEGER PRIMARY KEY AUTOINCREMENT);

CREATE TABLE TBL_AUTH_GROUP_seq  (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_AUTH_USER_seq   (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_DATABASE_seq    (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_OS_seq          (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_PRIORITY_seq    (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_RESOLUTION_seq  (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_SEVERITY_seq    (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_SITE_seq        (id INTEGER PRIMARY KEY AUTOINCREMENT);
CREATE TABLE TBL_VERSION_seq     (id INTEGER PRIMARY KEY AUTOINCREMENT);

# -- manually counted and set ...
#INSERT INTO TBL_AUTH_USER_seq  VALUES (1);
#INSERT INTO TBL_AUTH_GROUP_seq VALUES (9);
#INSERT INTO TBL_DATABASE_seq   VALUES (1);
#INSERT INTO TBL_OS_seq         VALUES (1);
#INSERT INTO TBL_PRIORITY_seq   VALUES (5);
#INSERT INTO TBL_RESOLUTION_seq VALUES (6);
#INSERT INTO TBL_SEVERITY_seq   VALUEs (7);
#INSERT INTO TBL_SITE_seq       VALUES (1);
#INSERT INTO TBL_STATUS_seq     VALUES (7);

# -- calculated ...
INSERT INTO TBL_AUTH_USER_seq (id)   SELECT COUNT(*) - 1 FROM TBL_AUTH_USER;
INSERT INTO TBL_AUTH_GROUP_seq (id)  SELECT COUNT(*) FROM TBL_AUTH_GROUP;
INSERT INTO TBL_DATABASE_seq (id)    SELECT COUNT(*) FROM TBL_DATABASE;
INSERT INTO TBL_OS_seq (id)          SELECT COUNT(*) FROM TBL_OS;
INSERT INTO TBL_PRIORITY_seq (id)    SELECT COUNT(*) FROM TBL_PRIORITY;
INSERT INTO TBL_RESOLUTION_seq (id)  SELECT COUNT(*) FROM TBL_RESOLUTION;
INSERT INTO TBL_SEVERITY_seq (id)    SELECT COUNT(*) FROM TBL_SEVERITY;
INSERT INTO TBL_SITE_seq (id)        SELECT COUNT(*) FROM TBL_SITE;
INSERT INTO TBL_STATUS_seq (id)      SELECT COUNT(*) FROM TBL_STATUS;

